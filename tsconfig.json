{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "bpcl/common": [
        "libs/common/src"
      ],
      "bpcl/common/*": [
        "libs/common/src/*"
      ]
      ,
      "@bpcl/fabric": [
        "libs/fabric/src"
      ],
      "@bpcl/fabric/*": [
        "libs/fabric/src/*"
      ],
    }
  },
  "include": [
    "src/**/*"
  ]
}